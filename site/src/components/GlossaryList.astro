---
import Icon from './Icon.astro';
// The glossary: search box plus all terms by group. `full` (the Glossary page) adds group jump links,
// anchor ids and "Nodes / Lessons" references; the compact version lives in the lesson side panel.
import { TERMS, type Term } from '../data/glossary';
import { TUTORIALS, lessonUrl, url } from '../lib/tutorials';
import { linkTerms } from '../lib/terms';

interface Props { full?: boolean }
const { full = false } = Astro.props;
const GROUPS: Term['group'][] = ['Graph', 'Models', 'Generating', 'Images and masks', 'Control'];
const slug = (g: string) => `g-${g.toLowerCase().replace(/ /g, '-')}`;
const classesIn = (t: (typeof TUTORIALS)[number]) => new Set(Object.values(t.graph).map((n) => n.class_type));
const lessonsFor = (term: Term) => (term.classes?.length ? TUTORIALS.filter((t) => term.classes!.some((c) => classesIn(t).has(c))) : []);
// Link other terms inside a definition, but never the entry's own term.
const define = (term: Term, text: string) => linkTerms(text)
  .replace(new RegExp(`<span class="term-wrap"><button type="button" class="term" data-term="${term.id}">([^<]*)</button>([^<]*)</span>`), '$1$2')
  .replace(new RegExp(`<button type="button" class="term" data-term="${term.id}">([^<]*)</button>`), '$1');
---
<div class:list={['glossary', { full }]} data-glossary>
  <div class="filters">
    <label class="search">
      <Icon name="magnifying-glass" />
      <input type="search" placeholder="Search terms" aria-label="Search terms" data-q />
      <button type="button" class="clear" aria-label="Clear search" data-clear hidden>
        <Icon name="x" size={14} />
      </button>
    </label>
    {full && <nav class="jump" aria-label="Groups">{GROUPS.map((g) => <a href={`#${slug(g)}`}>{g}</a>)}</nav>}
  </div>

  {GROUPS.map((g) => (
    <section class="group" id={full ? slug(g) : undefined} data-group>
      <h2 class="display">{g}</h2>
      <dl class="terms">
        {TERMS.filter((t) => t.group === g).map((t) => {
          const lessons = full ? lessonsFor(t) : [];
          return (
            <div class="entry" id={full ? t.id : undefined} data-entry={t.id}
              data-search={`${t.term} ${t.short} ${t.more ?? ''} ${(t.match ?? []).join(' ')}`.toLowerCase()}>
              <dt>{full ? <a class="anchor" href={`#${t.id}`}>{t.term}</a> : t.term}</dt>
              <dd>
                <p set:html={define(t, t.short)} />
                {t.more && <p class="more" set:html={define(t, t.more)} />}
                {full && (t.classes?.length || lessons.length > 0) && (
                  <div class="refs">
                    {t.classes?.length && <span class="lbl">Nodes</span>}
                    {t.classes?.map((c) => <a class="mono ref" href={url(`nodes/#${c}`)}>{c}</a>)}
                    {lessons.length > 0 && <span class="lbl">Lessons</span>}
                    {lessons.map((l) => <a class="mono ref" href={lessonUrl(l)} title={l.title}>{l.n}</a>)}
                  </div>
                )}
              </dd>
            </div>
          );
        })}
      </dl>
    </section>
  ))}
  <p class="empty" data-empty hidden>No terms match.</p>
</div>

<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-bottom: 12px; }
  .search { display: flex; align-items: center; gap: 10px; height: 44px; padding: 0 4px 0 14px; background: var(--panel); border: 1px solid var(--line-2); color: var(--muted); width: 300px; max-width: 100%; }
  .glossary:not(.full) .search { width: 100%; background: var(--bg); }
  .search:focus-within { border-color: var(--cyan); }
  .search input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--text); font: inherit; font-size: 15px; }
  .search input::-webkit-search-cancel-button { display: none; }
  .clear { width: 36px; height: 36px; display: grid; place-items: center; background: transparent; border: 0; color: var(--muted); cursor: pointer; }
  .clear:hover { color: var(--text); }
  .clear[hidden] { display: none; }
  .jump { display: flex; flex-wrap: wrap; gap: 18px; font-size: 15px; }
  .jump a { color: var(--text-2); text-decoration: none; }
  .jump a:hover { color: var(--text); }
  .group { padding-top: 28px; scroll-margin-top: 16px; }
  .glossary:not(.full) .group { padding-top: 16px; }
  .group[hidden] { display: none; }
  .group h2 { margin: 0 0 8px; font-size: 22px; font-weight: 600; color: var(--cyan); }
  .glossary:not(.full) .group h2 { font-size: 15px; letter-spacing: 0.06em; margin-bottom: 4px; }
  .terms { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; }
  .glossary:not(.full) .terms { grid-template-columns: minmax(0, 1fr); }
  .entry { padding: 16px 0; border-top: 1px solid var(--line); scroll-margin-top: 24px; transition: background 0.4s; }
  .glossary:not(.full) .entry { padding: 12px 0; }
  .entry[hidden] { display: none; }
  .entry:target, .entry.flash { background: color-mix(in srgb, var(--cyan) 8%, transparent); box-shadow: -12px 0 0 color-mix(in srgb, var(--cyan) 8%, transparent), 12px 0 0 color-mix(in srgb, var(--cyan) 8%, transparent); }
  dt { font-family: var(--display); font-weight: 700; font-size: 20px; text-transform: uppercase; letter-spacing: 0.02em; }
  .glossary:not(.full) dt { font-size: 16px; }
  .anchor { color: var(--text); text-decoration: none; }
  .anchor:hover { color: var(--cyan); }
  dd { margin: 6px 0 0; }
  dd p { margin: 0 0 8px; color: var(--text-2); }
  .glossary:not(.full) dd p { font-size: 15px; margin-bottom: 6px; }
  .more { font-size: 15px; color: var(--muted); }
  .glossary:not(.full) .more { font-size: 14px; }
  .refs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 4px; }
  .lbl { font-size: 13px; color: var(--muted); margin-right: 2px; }
  .ref + .lbl { margin-left: 10px; }
  .ref { font-size: 12px; padding: 2px 7px; border: 1px solid var(--line-2); color: var(--text-2); text-decoration: none; }
  .ref:hover { border-color: var(--cyan); color: var(--cyan); }
  .empty { color: var(--muted); }
  @media (max-width: 800px) { .terms { grid-template-columns: minmax(0, 1fr); } .search { width: 100%; } }
</style>

<script>
  const scrollParent = (el: HTMLElement): HTMLElement | null => {
    for (let p = el.parentElement; p; p = p.parentElement) {
      const o = getComputedStyle(p).overflowY;
      if ((o === 'auto' || o === 'scroll') && p.scrollHeight > p.clientHeight) return p;
    }
    return null;
  };
  for (const root of document.querySelectorAll<HTMLElement>('[data-glossary]')) {
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
    const entries = [...root.querySelectorAll<HTMLElement>('[data-entry]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const apply = () => {
      const s = q.value.trim().toLowerCase();
      clear.hidden = !s;
      entries.forEach((e) => (e.hidden = !!s && !e.dataset.search!.includes(s)));
      groups.forEach((g) => (g.hidden = !g.querySelector('[data-entry]:not([hidden])')));
      empty.hidden = entries.some((e) => !e.hidden);
    };
    q.addEventListener('input', apply);
    q.addEventListener('keydown', (e) => { if (e.key === 'Escape' && q.value) { e.stopPropagation(); q.value = ''; apply(); } });
    clear.addEventListener('click', () => { q.value = ''; apply(); q.focus(); });
    // Show one entry: clear the search, scroll it to the top of its scroll box and flash it.
    root.addEventListener('glossary:focus', ((e: CustomEvent<string>) => {
      const entry = entries.find((x) => x.dataset.entry === e.detail);
      if (!entry) return;
      q.value = '';
      apply();
      const box = scrollParent(entry);
      if (box) box.scrollTop += entry.getBoundingClientRect().top - box.getBoundingClientRect().top - 8;
      else entry.scrollIntoView({ block: 'start' });
      entries.forEach((x) => x.classList.toggle('flash', x === entry));
      setTimeout(() => entry.classList.remove('flash'), 1600);
    }) as EventListener);
  }
</script>
