---
import Icon from '../components/Icon.astro';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { HOWTO_MD, TUTORIALS, lessonUrl, url } from '../lib/tutorials';
import { MODEL_FILES, packsFor } from '../data/meta';
import { linkTerms } from '../lib/terms';
import SpeedChart from '../components/SpeedChart.astro';

// Matched sets: a model, its text encoder (with the CLIPLoader type) and its VAE belong together.
const FAMILIES: { name: string; note: string; files: string[] }[] = [
  { name: 'SDXL', note: 'One checkpoint holds model, text encoder and VAE. ControlNet and IP-Adapter add on to it.', files: [
    'Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors',
    'controlnet-union-sdxl-promax.safetensors',
    'ip-adapter-plus_sdxl_vit-h.safetensors',
    'CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors',
  ] },
  { name: 'Z-Image Turbo', note: 'Load CLIP with type lumina2. Sampler res_multistep, scheduler simple, 8 steps, CFG 1.', files: [
    'z_image_turbo_bf16.safetensors',
    'qwen_3_4b.safetensors',
    'ae.safetensors',
  ] },
  { name: 'Krea-2 Turbo', note: 'Load CLIP with type krea2. Sampler euler, scheduler simple, 8 steps, CFG 1. Does not run on Apple silicon Macs: the model file is fp8, which the Mac GPU backend does not support.', files: [
    'krea2_turbo_fp8_scaled.safetensors',
    'qwen3vl_4b_fp8_scaled.safetensors',
    'qwen_image_vae.safetensors',
    'krea2_darkbrush.safetensors',
  ] },
  { name: 'Flux.2 Klein 4B', note: 'Load CLIP with type flux2. Flux2Scheduler with 4 steps, CFG 1.', files: [
    'flux-2-klein-4b.safetensors',
    'qwen_3_4b.safetensors',
    'flux2-vae.safetensors',
  ] },
  { name: 'Utilities', note: 'Upscaling and background removal.', files: [
    '4x-UltraSharp.safetensors',
    'birefnet.safetensors',
  ] },
];
const usedIn = (file: string) => TUTORIALS.filter((t) => t.models.includes(file));
const inputs = [...new Set(TUTORIALS.flatMap((t) => t.images))].map((f) => ({ f, lessons: TUTORIALS.filter((t) => t.images.includes(f)) }));
const packs = [...new Map(TUTORIALS.flatMap((t) => packsFor(t.graph).map((p) => [p.pack, { ...p, lessons: TUTORIALS.filter((u) => packsFor(u.graph).some((q) => q.pack === p.pack)) }]))).values()];
const modelCount = new Set(FAMILIES.flatMap((f) => f.files)).size;
const howto = marked.parse(HOWTO_MD, { async: false, breaks: true }) as string;
---
<Base title="Setup and models | Learn ComfyUI" description="Install ComfyUI, get the models each lesson needs, and load a workflow.">
  <section class="head wrap">
    <div class="eyebrow">Before mission 00</div>
    <h1 class="display">Setup and models</h1>
    <p>Three steps to your first lesson. The reference below has the details.</p>
  </section>

  <section class="steps wrap">
    <article class="step">
      <span class="n display" aria-hidden="true">1</span>
      <h2 class="display">Install ComfyUI</h2>
      <p><a href="https://www.comfy.org/download">Download Comfy Desktop</a> for Windows or macOS and install it.</p>
      <p class="aside">Already have ComfyUI? Update it first. Older versions miss nodes the lessons use.</p>
    </article>
    <article class="step">
      <span class="n display" aria-hidden="true">2</span>
      <h2 class="display">Add the lessons</h2>
      <p>Unzip into your ComfyUI folder, the one with <code>models</code>, <code>input</code> and <code>user</code> in it. Then press <kbd>Ctrl</kbd>+<kbd>R</kbd> in ComfyUI.</p>
      <a class="btn btn-primary zip" href={url('workflows/comfyui-tutorials.zip')} download><Icon name="file-zip" /> Download all workflows</a>
      <p class="aside"><a href="#folder">Can't find the folder?</a></p>
    </article>
    <article class="step">
      <span class="n display" aria-hidden="true">3</span>
      <h2 class="display">Open a lesson and run it</h2>
      <p>Press <kbd>W</kbd>, open Tutorials, start with <a href={lessonUrl(TUTORIALS[0])}>00: node basics</a>. If a model is missing, ComfyUI offers to download it. Then press Run.</p>
      <p class="aside">Lesson 12 needs <a href="#custom-nodes">one custom node pack</a>.</p>
    </article>
  </section>

  <section class="ref wrap" aria-labelledby="ref-h">
    <h2 id="ref-h" class="display">Reference</h2>

    <details id="folder">
      <summary><span class="t display">ComfyUI folder</span><span class="s">Where it is, and adding one lesson at a time</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body prose-ish">
        <p>Comfy Desktop keeps it in <code>Documents\ComfyUI</code> on Windows and <code>~/Documents/ComfyUI</code> on macOS, or in the folder you picked during install. It's the folder that contains <code>models</code>, <code>input</code> and <code>user</code>.</p>
        <p>To add a single lesson instead: download it from its lesson page, drag the file onto the ComfyUI canvas and press <kbd>Ctrl</kbd>+<kbd>S</kbd> so it stays in the Workflows panel.</p>
      </div>
    </details>

    <details id="custom-nodes">
      <summary><span class="t display">Custom nodes</span><span class="s">{packs.map((p) => p.pack).join(', ')} for lesson {packs.flatMap((p) => p.lessons.map((t) => t.n)).join(', ')}. Everything else is built in.</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body prose-ish">
        {packs.map((p) => (
          <p><a href={p.url}><code>{p.pack}</code></a>, used in {p.lessons.map((t, i) => <>{i ? ', ' : ''}<a href={lessonUrl(t)}>{t.n}</a></>)}. In ComfyUI, open the Manager, search for the pack, install it and restart ComfyUI. If you open the lesson first, the Manager's Install Missing Custom Nodes finds it for you.</p>
        ))}
      </div>
    </details>

    <details id="models">
      <summary><span class="t display">Models</span><span class="s">{modelCount} files in {FAMILIES.length} sets, with manual download links</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body">
        <p class="lead" set:html={linkTerms('Model, text encoder and VAE are a matched set. Never swap one without the others.')} />
        <div class="callout">
          <p>If ComfyUI does not offer a download, or you prefer to fetch files yourself, use the links below and put each file in the folder shown, inside ComfyUI's <code>models</code> folder. Files marked <span class="rename">rename</span> are published under another name: save them with the name shown here.</p>
        </div>
        <div class="families">
          {FAMILIES.map((fam) => (
            <article class="family">
              <div class="hazard"></div>
              <div class="fam-body">
                <h3 class="display">{fam.name}</h3>
                <p class="fam-note" set:html={linkTerms(fam.note)} />
                <table>
                  <thead><tr><th>File</th><th>Folder</th><th>Lessons</th></tr></thead>
                  <tbody>
                    {fam.files.map((f) => (
                      <tr>
                        <td>
                          <a class="dl" href={MODEL_FILES[f].url} download={f}>
                            <Icon name="download-simple" size={14} />
                            <code>{f}</code>
                          </a>
                          {MODEL_FILES[f].rename && <span class="rename" title="Published under another name. Save it with this name.">rename</span>}
                        </td>
                        <td class="mono folder">models/{MODEL_FILES[f].folder}</td>
                        <td class="lessons">{usedIn(f).map((t) => <a href={lessonUrl(t)}>{t.n}</a>)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </article>
          ))}
        </div>
      </div>
    </details>

    <details id="inputs">
      <summary><span class="t display">Input images</span><span class="s">{inputs.length} images from Meridian, included in the zip</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body narrow">
        <p class="lead">Lessons that start from an image load these from ComfyUI's <code>input</code> folder.</p>
        <table>
          <tbody>
            {inputs.map(({ f, lessons }) => (
              <tr><td><a class="dl" href={url(`inputs/${f}`)} download={f}><Icon name="download-simple" size={14} /><code>{f}</code></a></td><td class="lessons">{lessons.map((t) => <a href={lessonUrl(t)}>{t.n}</a>)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>

    <details id="canvas">
      <summary><span class="t display">Using the canvas</span><span class="s">Running a lesson, reading the graph, shortcuts</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body narrow prose" set:html={howto} />
    </details>

    <details id="speed">
      <summary><span class="t display">How long it takes</span><span class="s">Seconds per image for each model, measured</span><Icon name="caret-down" class="chev" /></summary>
      <div class="body"><SpeedChart /></div>
    </details>
  </section>

  <script>
    // Links like #folder open the matching reference row.
    const open = () => { const d = document.getElementById(location.hash.slice(1)); if (d instanceof HTMLDetailsElement) d.open = true; };
    addEventListener('hashchange', open);
    open();
  </script>
</Base>

<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; gap: 10px; }
  h1 { margin: 0; font-size: clamp(34px, 4vw, 52px); }
  .head p { margin: 0; font-size: 19px; color: var(--text-2); max-width: 820px; }

  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; padding-bottom: 72px; }
  .step { background: var(--panel); border: 1px solid var(--line); border-top: 3px solid var(--orange); padding: 24px 26px 26px; display: flex; flex-direction: column; gap: 10px; }
  .step .n { font-size: 56px; line-height: 1; font-weight: 700; color: var(--orange-text); }
  .step h2 { margin: 0; font-size: 24px; }
  .step p { margin: 0; color: var(--text-2); font-size: 17px; }
  .step .zip { align-self: flex-start; margin: 6px 0 2px; }
  .step .aside { margin-top: auto; padding-top: 6px; font-size: 15px; color: var(--muted); }

  .ref { padding-bottom: 64px; }
  .ref > h2 { margin: 0 0 8px; font-size: 20px; font-weight: 600; color: var(--muted); }
  details { border-bottom: 1px solid var(--line); }
  .ref > h2 + details { border-top: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(180px, 280px) minmax(0, 1fr) auto; align-items: baseline; gap: 4px 24px; padding: 18px 4px; }
  summary::-webkit-details-marker { display: none; }
  summary:hover .t, summary:focus-visible .t { color: var(--orange-text); }
  summary:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  summary .t { font-size: 20px; font-weight: 600; color: var(--text); }
  summary .s { color: var(--muted); font-size: 15px; }
  summary :global(.chev) { color: var(--muted); align-self: center; transition: transform 0.15s; }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { summary :global(.chev) { transition: none; } }
  .body { padding: 4px 4px 32px; }
  .body.narrow, .prose-ish { max-width: 760px; }
  .prose-ish p { margin: 0 0 10px; color: var(--text-2); }
  .lead { margin: 0 0 16px; color: var(--text-2); }

  .families { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .family { background: var(--panel); border: 1px solid var(--line); min-width: 0; }
  .family .hazard { height: 8px; }
  .fam-body { padding: 20px 24px 22px; }
  .family h3 { margin: 0 0 6px; font-size: 22px; }
  .fam-note { margin: 0 0 14px; color: var(--text-2); font-size: 15px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th { text-align: left; font-weight: 500; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding: 0 12px 8px 0; }
  td { padding: 9px 12px 9px 0; border-top: 1px solid var(--line); vertical-align: top; }
  td code { word-break: break-all; background: transparent; padding: 0; }
  .dl { display: inline-flex; align-items: flex-start; gap: 8px; color: var(--text); text-decoration: none; }
  .dl svg { flex-shrink: 0; margin-top: 3px; color: var(--orange-text); }
  .dl:hover, .dl:hover svg { color: var(--cyan); }
  .dl:hover code { text-decoration: underline; }
  .rename { display: inline-block; margin: 4px 0 0 22px; font-family: var(--mono); font-size: 11px; padding: 1px 6px; border: 1px solid var(--yellow); color: var(--yellow); }
  .callout .rename { margin: 0; }
  .callout { background: #231f0e; border: 1px solid #5a4a10; padding: 14px 18px; margin-bottom: 20px; }
  .callout p { margin: 0; color: var(--text-2); }
  .folder { font-size: 13px; color: var(--text-2); white-space: nowrap; }
  .lessons { display: flex; flex-wrap: wrap; gap: 6px; }
  .lessons a { font-family: var(--mono); font-size: 12px; padding: 2px 7px; border: 1px solid var(--line-2); color: var(--text-2); text-decoration: none; }
  .lessons a:hover { border-color: var(--cyan); color: var(--cyan); }
  @media (max-width: 900px) {
    .steps, .families { grid-template-columns: minmax(0, 1fr); }
    summary { grid-template-columns: minmax(0, 1fr) auto; }
    summary .s { grid-column: 1; grid-row: 2; }
    summary :global(.chev) { grid-column: 2; grid-row: 1 / span 2; }
    .folder { white-space: normal; }
  }
</style>
