---
import Base from '../layouts/Base.astro';
import { TUTORIALS, byModule, lessonUrl, url } from '../lib/tutorials';

const decks = byModule();
const first = TUTORIALS[0];
---
<Base title="Learn ComfyUI | Tested tutorial workflows" fit>
  <section class="hero">
    <div class="hero-text">
      <div class="hazard"></div>
      <div class="inner">
        <div class="eyebrow">{TUTORIALS.length} tutorials · every workflow tested</div>
        <h1 class="display">Learn ComfyUI by building real workflows</h1>
        <p>A graded series from a seven-node graph to inpainting, ControlNet and image editing. Every workflow runs as downloaded, and each lesson explains the graph on the graph itself: click a node to read what it does. Prompts and input art come from <a href="https://meridian-gules-eta.vercel.app/">Meridian</a>, a sci-fi horror game.</p>
        <div class="ctas">
          <a class="btn btn-primary" href={lessonUrl(first)} data-resume>Start with 00: node basics</a>
          <a class="btn btn-ghost" href={url('setup/')}>Setup and models</a>
        </div>
        <p class="zip">Or <a href={url('workflows/comfyui-tutorials.zip')} download>download all {TUTORIALS.length} workflows</a> as one zip. <a href={url('setup/')}>Setup</a> says where to put them.</p>
      </div>
    </div>
    <div class="hero-img">
      <img src={url('hero/robot.jpg')} alt="Close-up of a scratched off-white and orange maintenance robot with glowing cyan eyes in a workshop" style="object-position: 50% 30%" width="1600" height="1600" />
      <span class="mono cap">Result · mission 15 · Krea-2 sampler shootout</span>
    </div>
  </section>

  <section class="path wrap" aria-labelledby="path-h">
    <div class="sec-head">
      <h2 id="path-h" class="display">Flight path</h2>
      <span data-progress-text>Lessons you open are marked here. Progress stays in this browser.</span>
      <button type="button" class="reset" data-reset hidden title="Clears opened lessons and the wires saved in exercises">Reset progress</button>
    </div>
    <ol class="stops">
      {decks.map((d) => (
        <li class="deck" style={`--n:${d.lessons.length}`}>
          <span class="mono deck-name">Deck {d.deck} · {d.name}</span>
          <ol>
            {d.lessons.map((t) => (
              <li>
                <a href={lessonUrl(t)} data-stop={t.n} aria-label={`${t.n} ${t.title}`}>
                  <span class="mono dot">{t.n}</span>
                  <span class="cap">{t.short}</span>
                  <span class="pop" aria-hidden="true">
                    {t.results[0]
                      ? <img src={url(`results/${t.results[0].src}`)} alt="" loading="lazy" width="300" height="300" />
                      : <span class="pop-ph mono">{t.exercise ? 'Exercise' : 'Comparison'}</span>}
                    <span class="pop-body">
                      <span class="mono pop-meta">Mission {t.n} · {t.model}</span>
                      <span class="pop-title">{t.title}</span>
                      <span class="pop-desc">{t.desc}</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>

</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 620px) minmax(0, 1fr); min-height: 560px; }
  .hero-text { background: var(--panel); display: flex; flex-direction: column; }
  .inner { padding: 52px 56px 48px; display: flex; flex-direction: column; gap: 22px; flex: 1; }
  h1 { margin: 0; font-size: clamp(38px, 5vw, 58px); line-height: 1.02; }
  .inner p { margin: 0; font-size: 19px; color: var(--text-2); }
  .zip { margin: 12px 0 0; font-size: 15px; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: auto; padding-top: 12px; }
  .hero-img { position: relative; min-height: 320px; }
  .hero-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-img .cap { position: absolute; right: 20px; bottom: 20px; background: var(--bg); padding: 8px 12px; font-size: 12px; color: var(--text-2); }
  .sec-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 22px; color: var(--muted); }
  .sec-head h2 { margin: 0; font-size: 26px; font-weight: 600; color: var(--text); }
  .reset { margin-left: auto; min-height: 36px; padding: 0 12px; background: transparent; border: 1px solid var(--line-2); color: var(--text-2); font: 600 13px var(--display); letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; }
  .reset:hover { border-color: var(--hull); color: var(--text); }
  .path { padding-top: 48px; padding-bottom: 40px; border-bottom: 1px solid var(--line); }
  .stops { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); }
  .deck { grid-column: span var(--n); display: flex; flex-direction: column; gap: 14px; }
  .deck-name { font-size: 12px; color: var(--muted); border-top: 2px solid var(--line-2); padding-top: 8px; margin-right: 12px; text-transform: uppercase; }
  .deck ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  .deck li li { display: flex; }
  .deck a { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; text-decoration: none; position: relative; }
  .deck a::before { content: ''; position: absolute; top: 21px; left: 0; right: 0; height: 2px; background: var(--line-2); }
  .dot { position: relative; width: 44px; height: 44px; border-radius: 22px; display: grid; place-items: center; font-size: 14px; background: var(--bg); border: 1px solid #4a545f; color: var(--muted); }
  .deck a .cap { font-size: 13px; color: #8a939d; text-align: center; line-height: 1.2; }
  .deck a:hover .dot { border-color: var(--hull); color: var(--text); }
  .deck a.done .dot { background: var(--orange); border-color: var(--orange); color: var(--bg); }
  .deck a.done .cap { color: var(--text-2); }
  .deck a.current .dot { border: 3px solid var(--cyan); color: var(--cyan); }
  .deck a.current .cap { color: var(--cyan); }
  .deck-sec { padding-top: 44px; }
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .card { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .card:hover { border-color: #4a545f; color: var(--text); }
  .card img, .ph { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .ph { display: grid; place-items: center; font-size: 13px; color: var(--muted); border-bottom: 1px dashed var(--line-2); background-image: radial-gradient(#2a313a 1px, transparent 1px); background-size: 20px 20px; }
  .card-body { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); text-transform: uppercase; }
  .status { color: var(--cyan); }
  .card-title { font-family: var(--display); font-size: 20px; font-weight: 600; line-height: 1.2; }
  .card-desc { font-size: 15px; color: #b7bec6; }
  @media (max-width: 1100px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stops { grid-template-columns: minmax(0, 1fr); row-gap: 20px; }
    .deck { grid-column: auto; }
  }
  @media (max-width: 800px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .inner { padding: 32px 16px; }
    .hero-img { order: -1; min-height: 240px; }
    .deck a .cap { font-size: 12px; }
  }
  @media (max-width: 520px) {
    .cards { grid-template-columns: minmax(0, 1fr); }
    .dot { width: 36px; height: 36px; font-size: 12px; }
    .deck a::before { top: 17px; }
  }
  /* Hover or focus a stop: a card with the lesson's result and description. */
  .pop { display: none; position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); z-index: 5; width: 240px;
    background: var(--panel); border: 2px solid #6b7683; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6); text-align: left; pointer-events: none; }
  /* Keep the cards of the two first and two last stops inside the window. */
  .deck:first-child li:nth-child(-n+2) .pop { left: 0; transform: none; }
  .deck:last-child li:nth-last-child(-n+2) .pop { left: auto; right: 0; transform: none; }
  .deck a:hover .pop, .deck a:focus-visible .pop { display: block; }
  .pop img, .pop-ph { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .pop-ph { display: grid; place-items: center; font-size: 12px; color: var(--muted); background-image: radial-gradient(#2a313a 1px, transparent 1px); background-size: 16px 16px; }
  .pop-body { display: flex; flex-direction: column; gap: 4px; padding: 10px 12px 12px; }
  .pop-meta { font-size: 11px; color: var(--muted); text-transform: uppercase; }
  .pop-title { font-family: var(--display); font-size: 16px; font-weight: 600; line-height: 1.2; color: var(--text); }
  .pop-desc { font-size: 13px; line-height: 1.35; color: var(--text-2); }
  @media (hover: none) { .deck a:hover .pop { display: none; } }
  /* One-window layout (body.fit, see Base): hero takes the height the flight path leaves, type scales with the window. */
  @media (min-width: 900px) and (min-height: 600px) {
    .hero { flex: 1; min-height: 0; grid-template-columns: minmax(0, min(46vw, 820px)) minmax(0, 1fr); }
    .inner { padding: clamp(24px, 5vh, 56px) clamp(32px, 4vw, 56px); gap: clamp(12px, 2.2vh, 22px); }
    h1 { font-size: clamp(30px, min(3.7vw, 6vh), 76px); }
    .inner p { font-size: clamp(14px, min(1.2vw, 2.05vh), 21px); max-width: 62ch; }
    .zip { font-size: clamp(13px, min(1.1vw, 1.9vh), 16px); }
    .eyebrow { font-size: clamp(11px, 1.6vh, 13px); }
    .path { padding-top: clamp(14px, 3vh, 40px); padding-bottom: clamp(14px, 3vh, 36px); border-bottom: 0; }
    .path .sec-head { margin-bottom: clamp(10px, 2vh, 22px); }
    .path .sec-head h2 { font-size: clamp(20px, 2.8vh, 26px); }
    .dot { width: clamp(34px, 5vh, 44px); height: clamp(34px, 5vh, 44px); }
    .deck a::before { top: calc(clamp(34px, 5vh, 44px) / 2 - 1px); }
    .stops { grid-template-columns: repeat(16, minmax(0, 1fr)); row-gap: 0; }
    .deck { grid-column: span var(--n); }
    .deck a .cap { font-size: clamp(11px, 1vw, 13px); }
  }
</style>

<script>
  let seen: string[] = [];
  try { seen = JSON.parse(localStorage.getItem('seen-lessons') || '[]'); } catch { /* storage blocked */ }
  const stops = [...document.querySelectorAll<HTMLAnchorElement>('[data-stop]')];
  const next = stops.find((a) => !seen.includes(a.dataset.stop!));
  for (const a of stops) {
    a.classList.toggle('done', seen.includes(a.dataset.stop!));
    a.classList.toggle('current', a === next && seen.length > 0);
  }
  // Reset clears everything the course keeps in this browser: opened lessons and saved exercise wires.
  const reset = document.querySelector<HTMLButtonElement>('[data-reset]')!;
  let wiredKeys: string[] = [];
  try { wiredKeys = Object.keys(localStorage).filter((k) => k.startsWith('wired-')); } catch { /* storage blocked */ }
  reset.hidden = seen.length === 0 && wiredKeys.length === 0;
  reset.addEventListener('click', () => {
    try {
      localStorage.removeItem('seen-lessons');
      wiredKeys.forEach((k) => localStorage.removeItem(k));
    } catch { /* storage blocked */ }
    location.reload();
  });
  if (seen.length) {
    const text = document.querySelector('[data-progress-text]');
    if (text) text.textContent = `${seen.length} of ${stops.length} opened. Progress stays in this browser.`;
    if (next) {
      const resume = document.querySelector<HTMLAnchorElement>('[data-resume]')!;
      resume.href = next.href;
      resume.textContent = `Resume: ${next.getAttribute('aria-label')}`;
      const card = document.querySelector(`[data-card="${next.dataset.stop}"] [data-status]`);
      if (card) card.textContent = 'Next';
    }
  }
</script>
