:"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"properties":{},"widgets_values":["tut/04_klein"],"widgets_values_named":{"filename_prefix":"tut/04_klein"}},{"id":14,"type":"MarkdownNote","pos":[1442,1250],"size":[706,193],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"title":"Try this","properties":{},"widgets_values":["## Try this\n\n1. Change **steps** in the Scheduler: 2 vs 4 vs 8.\n2. Change the **seed** in Random Noise.\n3. Width/height appear **twice** (Scheduler and Empty Latent) - keep them equal! *Advanced:* right-click a node → convert a widget to an input, then feed both from one **Int** primitive node."],"widgets_values_named":{"text":"## Try this\n\n1. Change **steps** in the Scheduler: 2 vs 4 vs 8.\n2. Change the **seed** in Random Noise.\n3. Width/height appear **twice** (Scheduler and Empty Latent) - keep them equal! *Advanced:* right-click a node → convert a widget to an input, then feed both from one **Int** primitive node."},"color":"#232","bgcolor":"#353"},{"id":15,"type":"MarkdownNote","pos":[-640,40],"size":[560,668],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"04 · Flux.2 Klein: the KSampler taken apart","properties":{},"widgets_values":["## 04 · Flux.2 Klein: the KSampler taken apart\n\n**KSampler** hides five decisions in one box. **SamplerCustomAdvanced** takes them as five separate inputs, each from its own node:\n\n| Input | Node | Type |\n|---|---|---|\n| noise | Random Noise | NOISE (the seed) |\n| guider | CFG Guider | GUIDER (model + prompts + cfg) |\n| sampler | Sampler Select | SAMPLER (euler, …) |\n| sigmas | Scheduler | SIGMAS (the step schedule) |\n| latent_image | Empty Latent | LATENT |\n\nSame idea, more control - many new models' templates use this style.\nFlux.2 Klein 4B (distilled) needs only **4 steps**. It's also the image **editor** in tutorial 13.\n\n### How to use every tutorial\n1. Read this box, then the boxes **below** the nodes (left → right).\n2. Click **Run** (or **Ctrl+Enter**). The result appears in the Save/Preview node and the queue panel.\n3. Do the **Try this** experiments and Run again - learning = changing one thing at a time.\n\n**Reading the graph:** coloured frames run **left → right**: 1 MODELS → 2 INPUTS → 3 PROMPTS → 4 GENERATE → 5 OUTPUT. Wires only turn in the gaps between columns; the **dots** on wires are *reroutes* (drag one to re-route a wire). Follow a wire by its colour = its data type.\n\n**Canvas tips:** drag empty space to pan · scroll to zoom · **.** fits everything · double-click empty canvas to **search & add a node** · click a node + **Ctrl+B** bypasses it · **Ctrl+Z** undo."],"widgets_values_named":{"text":"## 04 · Flux.2 Klein: the KSampler taken apart\n\n**KSampler** hides five decisions in one box. **SamplerCustomAdvanced** takes them as five separate inputs, each from its own node:\n\n| Input | Node | Type |\n|---|---|---|\n| noise | Random Noise | NOISE (the seed) |\n| guider | CFG Guider | GUIDER (model + prompts + cfg) |\n| sampler | Sampler Select | SAMPLER (euler, …) |\n| sigmas | Scheduler | SIGMAS (the step schedule) |\n| latent_image | Empty Latent | LATENT |\n\nSame idea, more control - many new models' templates use this style.\nFlux.2 Klein 4B (distilled) needs only **4 steps**. It's also the image **editor** in tutorial 13.\n\n### How to use every tutorial\n1. Read this box, then the boxes **below** the nodes (left → right).\n2. Click **Run** (or **Ctrl+Enter**). The result appears in the Save/Preview node and the queue panel.\n3. Do the **Try this** experiments and Run again - learning = changing one thing at a time.\n\n**Reading the graph:** coloured frames run **left → right**: 1 MODELS → 2 INPUTS → 3 PROMPTS → 4 GENERATE → 5 OUTPUT. Wires only turn in the gaps between columns; the **dots** on wires are *reroutes* (drag one to re-route a wire). Follow a wire by its colour = its data type.\n\n**Canvas tips:** drag empty space to pan · scroll to zoom · **.** fits everything · double-click empty canvas to **search & add a node** · click a node + **Ctrl+B** bypasses it · **Ctrl+Z** undo."},"color":"#223","bgcolor":"#335"}],"links":[[14,2,0,4,0,"CLIP"],[15,4,0,5,0,"CONDITIONING"],[16,1,0,6,0,"MODEL"],[17,4,0,6,1,"CONDITIONING"],[18,5,0,6,2,"CONDITIONING"],[19,7,0,11,0,"NOISE"],[20,6,0,11,1,"GUIDER"],[21,8,0,11,2,"SAMPLER"],[22,9,0,11,3,"SIGMAS"],[23,10,0,11,4,"LATENT"],[24,11,0,12,0,"LATENT"],[25,3,0,12,1,"VAE"],[26,12,0,13,0,"IMAGE"]],"groups":[{"id":1,"title":"1 · MODELS","bounding":[0,0,368,600],"color":"#A88","flags":{}},{"id":2,"title":"3 · PROMPTS & CONDITIONING","bounding":[460,0,838,642],"color":"#88A","flags":{}},{"id":3,"title":"4 · GENERATE","bounding":[1408,0,774,1507],"color":"#8A8","flags":{}},{"id":4,"title":"5 · OUTPUT","bounding":[2274,0,738,732],"color":"#3f789e","flags":{}}],"config":{},"extra":{"ds":{"scale":0.9,"offset":[416,110]},"linkExtensions":[{"id":17,"parentId":1},{"id":18,"parentId":5},{"id":20,"parentId":7},{"id":21,"parentId":9},{"id":22,"parentId":11},{"id":23,"parentId":13},{"id":25,"parentId":15}],"reroutes":[{"id":1,"parentId":2,"pos":[1362,162],"linkIds":[17]},{"id":2,"parentId":3,"pos":[1362,370],"linkIds":[17]},{"id":3,"parentId":4,"pos":[920,370],"linkIds":[17]},{"id":4,"pos":[920,300],"linkIds":[17]},{"id":5,"parentId":6,"pos":[1344,182],"linkIds":[18]},{"id":6,"pos":[1344,300],"linkIds":[18]},{"id":7,"parentId":8,"pos":[1768,634],"linkIds":[20]},{"id":8,"pos":[1768,142],"linkIds":[20]},{"id":9,"parentId":10,"pos":[1786,654],"linkIds":[21]},{"id":10,"pos":[1786,772],"linkIds":[21]},{"id":11,"parentId":12,"pos":[1804,674],"linkIds":[22]},{"id":12,"pos":[1804,906],"linkIds":[22]},{"id":13,"parentId":14,"pos":[1822,694],"linkIds":[23]},{"id":14,"pos":[1822,1088],"linkIds":[23]},{"id":15,"parentId":16,"pos":[2228,634],"linkIds":[25]},{"id":16,"parentId":17,"pos":[2228,544],"linkIds":[25]},{"id":17,"parentId":18,"pos":[414,544],"linkI